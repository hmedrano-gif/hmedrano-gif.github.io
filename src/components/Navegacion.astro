---
import { perfil } from "../data/perfil";
const enlaces = [
  ["#sobre-mi", "Sobre mí"], ["#proyectos", "Proyectos"], ["#tecnologias", "Tecnologías"],
  ["#docencia", "Docencia"], ["#investigacion", "Investigación"], ["#contacto", "Contacto"],
];
---
<header id="barra" class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-colors">
  <nav class="contenedor flex h-16 items-center justify-between" aria-label="Principal">
    <a href="#inicio" class="flex items-center gap-2 font-display text-base font-extrabold text-marino-900 dark:text-white">
      <span class="grid h-8 w-8 place-items-center rounded-lg bg-marino-900 text-xs text-white dark:bg-tec-600">HM</span>
      <span class="hidden sm:inline">{perfil.nombre}</span>
    </a>
    <ul class="hidden items-center gap-6 text-sm font-medium lg:flex">
      {enlaces.map(([h, t]) => <li><a href={h} class="text-slate-600 hover:text-tec-600 dark:text-slate-300 dark:hover:text-tec-400">{t}</a></li>)}
    </ul>
    <div class="flex items-center gap-2">
      <button id="tema" type="button" class="grid h-9 w-9 place-items-center rounded-lg border border-slate-200 text-slate-600 hover:bg-slate-100 dark:border-marino-700 dark:text-slate-300 dark:hover:bg-marino-800" aria-label="Cambiar entre modo claro y oscuro">
        <svg class="h-4 w-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <svg class="hidden h-4 w-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <button id="menu" type="button" class="grid h-9 w-9 place-items-center rounded-lg border border-slate-200 text-slate-600 lg:hidden dark:border-marino-700 dark:text-slate-300" aria-label="Abrir menú" aria-expanded="false" aria-controls="menu-movil">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </nav>
  <ul id="menu-movil" class="hidden border-t border-slate-200 bg-white px-4 py-3 text-sm font-medium lg:hidden dark:border-marino-800 dark:bg-marino-950">
    {enlaces.map(([h, t]) => <li><a href={h} class="block py-2 text-slate-700 dark:text-slate-200">{t}</a></li>)}
  </ul>
</header>
<script is:inline>
  const barra = document.getElementById("barra");
  addEventListener("scroll", () => {
    const s = scrollY > 20;
    barra.classList.toggle("bg-white/90", s); barra.classList.toggle("dark:bg-marino-950/90", s);
    barra.classList.toggle("backdrop-blur", s); barra.classList.toggle("border-slate-200", s); barra.classList.toggle("dark:border-marino-800", s);
  }, { passive: true });
  document.getElementById("tema").addEventListener("click", () => {
    const o = document.documentElement.classList.toggle("dark");
    try { localStorage.setItem("tema", o ? "oscuro" : "claro"); } catch (e) {}
  });
  const bm = document.getElementById("menu"), mm = document.getElementById("menu-movil");
  bm.addEventListener("click", () => { const a = mm.classList.toggle("hidden"); bm.setAttribute("aria-expanded", String(!a)); });
  mm.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => { mm.classList.add("hidden"); bm.setAttribute("aria-expanded", "false"); }));
</script>
